# Токен от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую — им приходят новые записи и отмены.
# Свой ID можно узнать, отправив боту команду /id
ADMIN_IDS=

# Хранилище. Если переменных нет — бот пишет в data/bookings.json (локальный режим).
# На Vercel: Storage → Upstash Redis, переменные подставляются автоматически.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Произвольная строка: Telegram будет слать её в заголовке, чужие запросы отсекутся.
WEBHOOK_SECRET=

# Vercel подставляет сам при включённом cron — задавать вручную не нужно.
CRON_SECRET=
